rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null; }
    function isMember(hid) {
      return authed()
        && get(/databases/$(database)/documents/user_authorizations/$(request.auth.uid)).data.state == 'active'
        && get(/databases/$(database)/documents/user_authorizations/$(request.auth.uid)).data.activeHouseholdId == hid
        && get(/databases/$(database)/documents/household_authorizations/$(hid)).data.state == 'active'
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }
    function ownAccountWritable(uid) {
      return authed() && request.auth.uid == uid
        && (!exists(/databases/$(database)/documents/user_authorizations/$(uid))
          || get(/databases/$(database)/documents/user_authorizations/$(uid)).data.state == 'active');
    }
    // Authority, lifecycle and invitations are server-only. Missing registry fails closed.
    match /user_authorizations/{uid} { allow read, write: if false; }
    match /household_authorizations/{hid} { allow read, write: if false; }
    match /household_invitations/{hash} { allow read, write: if false; }

    match /households/{hid} {
      allow read: if isMember(hid);
      allow create, delete: if false;
      allow update: if isMember(hid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vaccineVisibilitySettings']);
      match /members/{uid} {
        allow read: if isMember(hid);
        allow write: if false;
      }
      match /children/{childId} {
        allow read, write: if isMember(hid);
        match /events/{eventId} {
          allow read, delete: if isMember(hid);
          allow create, update: if isMember(hid)
            && request.resource.data.householdId == hid
            && request.resource.data.childId == childId;
        }
        match /{collection}/{document} {
          allow read, write: if isMember(hid)
            && collection in ['childRecords', 'growthRecords', 'babyFoodRecords', 'vaccination_records', 'reservation_groups', 'vaccination_schedules'];
        }
      }
      match /{collection}/{document} {
        allow read, write: if isMember(hid)
          && collection in ['events', 'momRecords', 'momDiary', 'custom_ingredients', 'settings', 'tags'];
      }
    }
    match /{path=**}/members/{uid} {
      allow read: if authed() && resource.data.uid == request.auth.uid;
    }
    match /users/{uid} {
      allow read: if authed() && request.auth.uid == uid;
      allow create: if ownAccountWritable(uid)
        && request.resource.data.keys().hasOnly(['createdAt', 'updatedAt', 'displayName']);
      allow update: if ownAccountWritable(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'displayName']);
      allow delete: if false;
      match /fcm_tokens/{deviceId} {
        allow read: if authed() && request.auth.uid == uid;
        allow write: if ownAccountWritable(uid);
      }
      match /notification_settings/{docId} {
        allow read: if authed() && request.auth.uid == uid;
        allow write: if ownAccountWritable(uid);
      }
    }
    // Application queries household events directly; no data-field-only collection-group grant.
  }
}
